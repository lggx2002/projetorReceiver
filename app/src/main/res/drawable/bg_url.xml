<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_highlight" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="@dimen/corner_radius" />
            <padding android:left="18dp" android:top="0dp" android:right="18dp" android:bottom="0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="@color/outline" />
            <corners android:radius="@dimen/corner_radius" />
            <padding android:left="18dp" android:top="0dp" android:right="18dp" android:bottom="0dp" />
        </shape>
    </item>
</selector>
