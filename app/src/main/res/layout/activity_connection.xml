<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipChildren="false"
    android:paddingStart="@dimen/screen_horizontal_padding"
    android:paddingEnd="@dimen/screen_horizontal_padding">

    <LinearLayout
        android:id="@+id/connection_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:maxWidth="@dimen/content_max_width"
        android:orientation="vertical">

        <TextView
            android:id="@+id/eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.18"
            android:text="@string/connection_eyebrow"
            android:textColor="@color/accent"
            android:textSize="@dimen/eyebrow_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/connection_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/title_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/connection_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/body_size" />

        <TextView
            android:id="@+id/server_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/server_ready"
            android:textColor="@color/accent"
            android:textSize="@dimen/body_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/server_endpoint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/body_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/server_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/small_size" />

        <TextView
            android:id="@+id/url_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/stream_url_label"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/eyebrow_size"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/url_input"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_url"
            android:gravity="center_vertical"
            android:hint="@string/stream_url_hint"
            android:imeOptions="actionDone"
            android:inputType="textUri"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textCursorDrawable="@null"
            android:textSize="@dimen/body_size" />

        <Button
            android:id="@+id/connect_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_connect"
            android:fontFamily="sans"
            android:focusable="true"
            android:minHeight="0dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/connect"
            android:textAllCaps="false"
            android:textColor="@color/accent_text"
            android:textSize="@dimen/body_size"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/auto_connect_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:buttonTint="@color/accent"
            android:paddingStart="4dp"
            android:text="@string/remember_auto_connect"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/small_size" />

        <TextView
            android:id="@+id/auto_connect_help"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginTop="-2dp"
            android:text="@string/auto_connect_help"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/small_size" />

        <TextView
            android:id="@+id/status_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/status_ready"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/small_size" />
    </LinearLayout>
</FrameLayout>
